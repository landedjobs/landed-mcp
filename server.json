{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.landedjobs/landed",
	"title": "Landed",
	"description": "Sign in with landed to search jobs ranked to your résumé and fetch free interview-prep resources.",
	"version": "0.3.0",
	"websiteUrl": "https://www.landed.jobs/mcp",
	"repository": {
		"url": "https://github.com/landedjobs/landed-mcp",
		"source": "github"
	},
	"icons": [
		{
			"src": "https://static.b100x.ai/landed-logos/landed-app-icon-square.png",
			"mimeType": "image/png",
			"sizes": ["1024x1024"],
			"theme": "dark"
		},
		{
			"src": "https://static.b100x.ai/landed-logos/landed-logotype-l-light-pad8.png",
			"mimeType": "image/png",
			"sizes": ["224x224"],
			"theme": "light"
		}
	],
	"remotes": [
		{
			"type": "streamable-http",
			"url": "https://mcp.landed.jobs/mcp",
			"headers": [
				{
					"name": "Authorization",
					"description": "Optional: a landed API token as \"Bearer <token>\" for clients without OAuth sign-in. Create one in landed Settings.",
					"placeholder": "Bearer lnd_live_...",
					"isRequired": false,
					"isSecret": true
				}
			]
		}
	]
}
