{
	"name": "landed-mcp",
	"version": "0.3.0",
	"description": "Landed's public Model Context Protocol server — sign in with landed to search jobs and pull free learning content from any MCP client.",
	"license": "MIT",
	"type": "module",
	"homepage": "https://mcp.landed.jobs",
	"repository": {
		"type": "git",
		"url": "https://github.com/landedjobs/landed-mcp.git"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"start:stdio": "tsx src/stdio.ts",
		"check-types": "tsc --noEmit",
		"test": "tsx --test src/mcp/tools/lib/*.test.ts src/http/*.test.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.0",
		"@sentry/node": "10.63.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.21.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/node": "^22.7.0",
		"tsx": "^4.19.0",
		"typescript": "5.8.3"
	}
}
